# ==========================================
# Ingot IAM 服务专用环境变量
# ==========================================

# ==================== 数据库配置 ====================
# IAM_DATABASE 由部署环境显式提供，必须指向已迁移验证的独立目标库。

# ==================== Tomcat配置 ====================
TOMCAT_THREADS_MAX=400
TOMCAT_THREADS_MIN=50
TOMCAT_MAX_CONNECTIONS=8000
TOMCAT_ACCEPT_COUNT=200
TOMCAT_CONNECTION_TIMEOUT=20000
TOMCAT_MAX_POST_SIZE=104857600

# ==================== IAM特定配置 ====================
# IAM服务特定的业务配置可以在此添加


meta {
  name: 读取根部门
  type: http
  seq: 6
}

get {
  url: {{gateway}}/iam/v1/tenant/departments?purpose=MANAGED_DEPARTMENT&page=1&pageSize=200
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenOwnerA}}
}

headers {
  Tenant: {{tenantA}}
}

script:post-response {
  const items = (res.getBody().data && res.getBody().data.items) || [];
  const root = items.find(i => !i.record.parentId) || items[0];
  if (root) bru.setEnvVar("rootDeptId", root.record.id);

}

tests {
  test("根部门已保存", function () {
    expect(res.getStatus()).to.equal(200);
    expect(bru.getEnvVar("rootDeptId")).to.be.a("string");
  });
}

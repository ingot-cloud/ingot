meta {
  name: 移出后账号仍在
  type: http
  seq: 14
}

get {
  url: {{gateway}}/iam/v1/platform/accounts/{{accountXId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenPlatform}}
}

script:post-response {
  const data = res.getBody().data;
  if (data) bru.setEnvVar("accountXVersion", data.version);

}

tests {
  test("账号行仍在且仍启用", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.record.enabled).to.equal(true);
  });
}

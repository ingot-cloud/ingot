meta {
  name: 独立授权仍在
  type: http
  seq: 10
}

get {
  url: {{gateway}}/iam/v1/tenant/assignments?page=1&pageSize=200
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenZ}}
}

headers {
  Tenant: {{tenantA}}
}

tests {
  test("旧所有者独立授权保留", function () {
    expect(res.getStatus()).to.equal(200);
    const items = res.getBody().data.items || [];
    const hit = items.some(i => String(i.record.id) === String(bru.getEnvVar("ownerIndependentAssignmentId")));
    expect(hit).to.equal(true);
  });
}

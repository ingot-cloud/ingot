meta {
  name: Z 登录（新所有者）
  type: http
  seq: 7
}

post {
  url: {{auth}}/oauth2/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{clientId}}
  password: {{clientSecret}}
}

body:form-urlencoded {
  grant_type: password
  username: {{accountZUsername}}
  password: {{accountZPassword}}
  user_type: 0
  domain: TENANT
  org: {{tenantA}}
}

script:post-response {
  const body = res.getBody();
  const token = body && body.data.accessToken;
  if (token) {
    bru.setEnvVar("tokenZ", token);
  }
  
}

tests {
  test("Z 可登录", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

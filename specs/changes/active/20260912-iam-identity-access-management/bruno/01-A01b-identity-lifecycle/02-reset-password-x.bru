meta {
  name: 重置 X 密码
  type: http
  seq: 2
}

post {
  url: {{gateway}}/iam/v1/platform/accounts/{{accountXId}}/reset-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenPlatform}}
}

body:json {
  {
    "expectedVersion": "{{accountXVersion}}"
  }
}

script:post-response {
  const data = res.getBody().data;
  if (data && data.password) bru.setEnvVar("accountXPassword", data.password);
  const detail = bru.getEnvVar("accountXVersion");

}

tests {
  test("一次性明文密码", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.password).to.be.a("string");
  });
}

docs {
  把返回的 password 写入环境 accountXPassword。随后 GET 账号刷新 version。
}

meta {
  name: 创建账号 X
  type: http
  seq: 1
}

post {
  url: {{gateway}}/iam/v1/platform/accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenPlatform}}
}

body:json {
  {
    "username": "{{accountXUsername}}",
    "phone": null,
    "email": null
  }
}

script:post-response {
  const data = res.getBody().data;
  if (data && data.id) {
    bru.setEnvVar("accountXId", data.id);
    bru.setEnvVar("accountXVersion", data.version);
  }

}

tests {
  test("账号 X 已创建", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().code).to.equal("S0200");
    expect(res.getBody().data.id).to.be.a("string");
  });
}

meta {
  name: 提交开通业务应用
  type: http
  seq: 9
}

put {
  url: {{gateway}}/iam/v1/platform/tenants/{{tenantA}}/entitlements
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenPlatform}}
}

body:json {
  {
    "expectedVersion": "{{entitlementVersion}}",
    "entitlements": []
  }
}

script:pre-request {
  const items = JSON.parse(bru.getEnvVar("entitlementItems") || "[]");
  const appId = bru.getEnvVar("bizAppId");
  if (!items.some(i => String(i.applicationId) === String(appId))) {
    items.push({ applicationId: appId, status: "ENABLED", validFrom: null, validUntil: null });
  }
  const payload = {
    expectedVersion: bru.getEnvVar("entitlementVersion"),
    entitlements: items
  };
  req.setBody(payload);
  
}

tests {
  test("开通已写入", function () {
    expect(res.getStatus()).to.equal(200);
    const items = res.getBody().data.items || [];
    const hit = items.some(i => String(i.record.applicationId) === String(bru.getEnvVar("bizAppId")));
    expect(hit).to.equal(true);
  });
}

meta {
  name: 重置 Y 密码
  type: http
  seq: 2
}

post {
  url: {{gateway}}/iam/v1/platform/accounts/{{accountYId}}/reset-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenPlatform}}
}

body:json {
  {
    "expectedVersion": "{{accountYVersion}}"
  }
}

script:post-response {
  const data = res.getBody().data;
  if (data && data.password) bru.setEnvVar("accountYPassword", data.password);

}

tests {
  test("Y 密码已返回", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

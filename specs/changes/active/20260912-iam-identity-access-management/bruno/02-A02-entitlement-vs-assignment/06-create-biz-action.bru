meta {
  name: 创建业务操作
  type: http
  seq: 6
}

post {
  url: {{gateway}}/iam/v1/platform/applications/{{bizAppId}}/actions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenPlatform}}
}

body:json {
  {
    "resourceId": "{{bizResourceId}}",
    "code": "{{bizActionCode}}",
    "name": "读取业务对象"
  }
}

script:pre-request {
  const stamp = bru.getEnvVar("runStamp");
  if (!bru.getEnvVar("bizActionCode")) bru.setEnvVar("bizActionCode", "a02-" + stamp + ":item:read");

}

script:post-response {
  const data = res.getBody().data;
  if (data && data.id) bru.setEnvVar("bizActionId", data.id);

}

tests {
  test("操作已创建", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

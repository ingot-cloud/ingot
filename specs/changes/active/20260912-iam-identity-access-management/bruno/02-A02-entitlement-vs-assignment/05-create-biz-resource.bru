meta {
  name: 创建业务资源
  type: http
  seq: 5
}

post {
  url: {{gateway}}/iam/v1/platform/applications/{{bizAppId}}/resources
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenPlatform}}
}

body:json {
  {
    "code": "item",
    "name": "业务对象",
    "scopeCapabilities": ["ALL"],
    "fieldCapabilities": []
  }
}

script:post-response {
  const data = res.getBody().data;
  if (data && data.id) bru.setEnvVar("bizResourceId", data.id);

}

tests {
  test("资源已创建", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

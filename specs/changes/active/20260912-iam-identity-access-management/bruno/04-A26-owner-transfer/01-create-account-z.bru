meta {
  name: 创建账号 Z
  type: http
  seq: 1
}

post {
  url: {{gateway}}/iam/v1/platform/accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenPlatform}}
}

body:json {
  {
    "username": "{{accountZUsername}}",
    "phone": null,
    "email": null
  }
}

script:post-response {
  const data = res.getBody().data;
  if (data && data.id) {
    bru.setEnvVar("accountZId", data.id);
    bru.setEnvVar("accountZVersion", data.version);
  }

}

tests {
  test("账号 Z 已创建", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

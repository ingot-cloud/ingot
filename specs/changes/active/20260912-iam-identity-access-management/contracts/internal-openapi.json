{
  "openapi": "3.0.3",
  "info": {
    "title": "IAM资源内部授权契约",
    "version": "2.0.0"
  },
  "paths": {
    "/inner/authorization/snapshot": {
      "post": {
        "operationId": "iamAuthorizationSnapshot",
        "description": "INNER受信任调用；在线重验原始身份和有效授权；请求身份仅可核对不能替代；platformAdministrator独立于permissionCodes，注解不能复用旧JWT或数据范围热缓存",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizationSnapshotRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "R信封；精确错误码区分拒绝和不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RAuthorizationSnapshotDTO"
                }
              }
            }
          },
          "400": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/inner/authorization/v2/evaluate": {
      "post": {
        "operationId": "iamEvaluateV2",
        "description": "INNER受信任调用及在线原始身份；请求不能替代用户；注册操作模式决定fresh或读热缓存",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "R信封；精确错误码区分拒绝和不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RAuthorizationDecision"
                }
              }
            }
          },
          "400": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/inner/iam/resource-objects/query": {
      "post": {
        "operationId": "resourceObjectQuery",
        "description": "固定资源服务白名单；HMAC覆盖payload及短时间窗；payload.context与原认证身份完全一致；只返回最小候选或存在性",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignedResourceObjectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "R信封；精确错误码区分拒绝和不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RResourceObjectResult"
                }
              }
            }
          },
          "400": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "稳定业务错误码；失败时data为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IamErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionDecision": {
        "required": [
          "fields"
        ],
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "governed": {
            "type": "boolean"
          },
          "scope": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScopeCondition"
            }
          },
          "fields": {
            "$ref": "#/components/schemas/FieldPolicyDecision"
          }
        }
      },
      "ActionGrant": {
        "required": [
          "actionId",
          "scopes"
        ],
        "type": "object",
        "properties": {
          "actionId": {
            "type": "string",
            "description": "操作 ID"
          },
          "scopes": {
            "type": "array",
            "description": "按并集合成的范围项",
            "items": {
              "$ref": "#/components/schemas/ScopeExpression"
            }
          }
        },
        "description": "操作及其范围，不允许脱离操作合并范围"
      },
      "ActionScopeCeiling": {
        "required": [
          "actionId",
          "scopeBindings",
          "scopes"
        ],
        "type": "object",
        "properties": {
          "actionId": {
            "type": "string",
            "description": "操作 ID"
          },
          "scopes": {
            "type": "array",
            "description": "该操作允许范围的并集",
            "items": {
              "$ref": "#/components/schemas/ScopeExpression"
            }
          },
          "scopeBindings": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ScopeBinding"
            },
            "description": "委派范围参数，不接受未绑定的管理范围"
          }
        },
        "description": "限定委派允许的单个操作与范围，范围参数在该委派内绑定"
      },
      "AuthorizationActionOption": {
        "required": [
          "id",
          "name",
          "scopeCapabilities"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "applicationId": {
            "type": "string"
          },
          "applicationName": {
            "type": "string"
          },
          "resourceId": {
            "type": "string"
          },
          "resourceName": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "scopeCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ALL",
                "SELF",
                "MEMBER_DEPARTMENTS",
                "MANAGED_DEPARTMENTS",
                "OBJECT_SET"
              ]
            }
          }
        }
      },
      "AuthorizationCandidatePage": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthorizationOption"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "supported": {
            "type": "boolean"
          },
          "unavailableMessage": {
            "type": "string"
          },
          "contextLabel": {
            "type": "string"
          },
          "hierarchical": {
            "type": "boolean"
          }
        }
      },
      "AuthorizationContext": {
        "required": [
          "accountId",
          "domain",
          "memberId"
        ],
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "当前管理域",
            "enum": [
              "PLATFORM",
              "TENANT"
            ]
          },
          "tenantId": {
            "type": "string",
            "description": "租户域必填；平台域为空"
          },
          "accountId": {
            "type": "string",
            "description": "全局账号 ID"
          },
          "memberId": {
            "type": "string",
            "description": "当前域的成员 ID"
          }
        },
        "description": "经认证选择的当前成员身份；不接受客户端直接指定权限域",
        "readOnly": true
      },
      "AuthorizationDecision": {
        "type": "object",
        "properties": {
          "resource": {
            "$ref": "#/components/schemas/ResourceKey"
          },
          "context": {
            "$ref": "#/components/schemas/AuthorizationContext"
          },
          "actions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ActionDecision"
            }
          },
          "version": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthorizationOption": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "roleRevisionRef": {
            "$ref": "#/components/schemas/RoleRevisionRef"
          },
          "parameterDefinitions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleParameterDefinition"
            }
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActionGrant"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthorizationActionOption"
            }
          },
          "delegation": {
            "$ref": "#/components/schemas/DelegationInput"
          },
          "parentId": {
            "type": "string"
          },
          "hasChildren": {
            "type": "boolean"
          },
          "ancestorPath": {
            "type": "string"
          },
          "selectable": {
            "type": "boolean"
          },
          "resourceFieldPermissions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/components/schemas/FieldAccess"
              }
            }
          }
        }
      },
      "AuthorizationRequest": {
        "required": [
          "actionCodes",
          "resource"
        ],
        "type": "object",
        "properties": {
          "resource": {
            "$ref": "#/components/schemas/ResourceKey"
          },
          "actionCodes": {
            "maxItems": 100,
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AuthorizationResourceRuleDTO": {
        "type": "object",
        "properties": {
          "resourceCode": {
            "type": "string"
          },
          "permissionCode": {
            "type": "string"
          },
          "scopeType": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3,
              9
            ]
          },
          "deptIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d+$"
            }
          },
          "self": {
            "type": "boolean"
          }
        }
      },
      "AuthorizationRoleBindingDTO": {
        "type": "object",
        "properties": {
          "roleId": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "platformRole": {
            "type": "boolean"
          },
          "roleCode": {
            "type": "string"
          },
          "deptId": {
            "type": "string",
            "pattern": "^\\d+$",
            "nullable": true
          },
          "filterDept": {
            "type": "boolean"
          }
        }
      },
      "AuthorizationSnapshotDTO": {
        "type": "object",
        "required": [
          "platformAdministrator",
          "passwordChangeRequired"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "userId": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "roleBindings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthorizationRoleBindingDTO"
            }
          },
          "permissionCodes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "passwordChangeRequired": {
            "type": "boolean",
            "description": "账号即时改密状态；缺失时消费方拒绝授权，为true时无业务或管理员资格"
          },
          "platformAdministrator": {
            "type": "boolean",
            "description": "仅服务器实时有效平台系统直接分配产生；不是业务操作码，租户恒为false"
          },
          "resourceRules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthorizationResourceRuleDTO"
            }
          },
          "source": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "emptyAuthorization": {
            "type": "boolean",
            "readOnly": true
          }
        }
      },
      "AuthorizationSnapshotRequest": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "pattern": "^\\d+$",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "pattern": "^\\d+$",
            "nullable": true
          }
        }
      },
      "DelegationInput": {
        "required": [
          "actionScopeCeilings",
          "administratorMemberId",
          "allowedRoleRevisionRefs",
          "recipientSelection"
        ],
        "type": "object",
        "properties": {
          "administratorMemberId": {
            "type": "string",
            "description": "当前域的授权管理员成员 ID"
          },
          "allowedRoleRevisionRefs": {
            "type": "array",
            "description": "允许分配的固定角色版本集合",
            "items": {
              "$ref": "#/components/schemas/RoleRevisionRef"
            }
          },
          "recipientSelection": {
            "$ref": "#/components/schemas/Selection"
          },
          "actionScopeCeilings": {
            "type": "array",
            "description": "逐操作范围上限",
            "items": {
              "$ref": "#/components/schemas/ActionScopeCeiling"
            }
          },
          "validFrom": {
            "type": "string",
            "description": "UTC 生效时间，包含；空值无起始边界",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "description": "UTC 失效时间，不包含；空值无结束边界",
            "format": "date-time"
          },
          "maxAssignmentDuration": {
            "type": "string",
            "description": "有限模式必填的正持续时间；不限模式为空",
            "format": "duration"
          },
          "assignmentDurationMode": {
            "type": "string",
            "description": "单次期限模式，省略按 LIMITED",
            "enum": [
              "LIMITED",
              "UNLIMITED"
            ],
            "default": "LIMITED"
          }
        },
        "description": "描述单条不可拼接的委派限制，角色、人群、范围与期限共同生效"
      },
      "DepartmentSelection": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "部门 ID"
          },
          "includeDescendants": {
            "type": "boolean",
            "description": "是否包含下级，默认 false"
          }
        },
        "description": "租户部门选择项；平台域不支持"
      },
      "FieldAccess": {
        "required": [
          "visibility"
        ],
        "type": "object",
        "properties": {
          "visibility": {
            "type": "string",
            "description": "字段可见程度",
            "enum": [
              "HIDDEN",
              "MASKED",
              "FULL"
            ]
          },
          "editable": {
            "type": "boolean",
            "description": "是否允许编辑，非 FULL 必须为 false"
          }
        },
        "description": "描述服务端计算后的字段输出与编辑能力，不独立授予对象或写操作权限"
      },
      "FieldPolicyDecision": {
        "type": "object",
        "properties": {
          "defaults": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldAccess"
            }
          },
          "ceilings": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldAccess"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResolvedFieldRule"
            }
          },
          "filterableFields": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sortableFields": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mergeMode": {
            "type": "string",
            "enum": [
              "RESTRICTIONS",
              "GRANTS"
            ]
          }
        }
      },
      "IamErrorEnvelope": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data",
          "success"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "InvalidArgument",
              "IdentityInvalid",
              "ActionDenied",
              "PasswordChangeRequired",
              "DataScopeDenied",
              "DelegationExceeded",
              "RoleRevisionUnavailable",
              "ApplicationUnavailable",
              "ObjectNotFound",
              "PolicyConflict",
              "RevisionConflict",
              "ObjectInUse",
              "StepUpFailed",
              "AuthorizationUnavailable"
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "nullable": true,
            "enum": [
              null
            ]
          },
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        }
      },
      "ObjectAssociation": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "ASSIGNMENT",
              "DELEGATION"
            ]
          },
          "id": {
            "type": "string"
          },
          "parameterKey": {
            "type": "string"
          },
          "actionId": {
            "type": "string"
          }
        }
      },
      "RAuthorizationDecision": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/AuthorizationDecision"
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "RAuthorizationSnapshotDTO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/AuthorizationSnapshotDTO"
          }
        }

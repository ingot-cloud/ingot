        "required": [
          "key",
          "kind"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "命名参数键，在当前版本内唯一"
          },
          "kind": {
            "type": "string",
            "description": "允许的绑定集合类型",
            "enum": [
              "DEPARTMENTS",
              "OBJECTS"
            ]
          }
        },
        "description": "声明角色版本中的命名范围参数及其绑定类型"
      },
      "RoleRevisionRef": {
        "required": [
          "id",
          "kind"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "角色版本来源种类",
            "enum": [
              "SYSTEM",
              "SHARED",
              "PLATFORM_CUSTOM",
              "TENANT_CUSTOM"
            ]
          },
          "id": {
            "type": "string",
            "description": "角色版本 ID，不是角色定义 ID"
          }

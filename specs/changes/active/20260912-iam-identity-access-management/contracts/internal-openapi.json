              "type": "string"
            }
          },
          "ownerMemberId": {
            "type": "string"
          },
          "departmentSets": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ScopeExpression": {
        "required": [
          "kind"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "范围种类",
            "enum": [
              "ALL",
              "SELF",
              "MEMBER_DEPARTMENTS",
              "MANAGED_DEPARTMENTS",
              "OBJECT_SET"
            ]
          },
          "parameterKey": {
            "type": "string",
            "description": "管理部门或对象集合的命名参数"
          },
          "includeDescendants": {
            "type": "boolean",
            "description": "部门范围是否包含下级"
          }

        "description": "当前域内的成员与部门选择"
      },
      "SignedResourceObjectRequest": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          },
          "signature": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
